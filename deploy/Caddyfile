{
	# Real ACME contact — without this Caddy can end up registering an account with an
	# invalid placeholder contact, which Let's Encrypt rejects outright.
	email {$ACME_EMAIL:ravisoni18@gmail.com}

	# HTTP/3 (QUIC) large multipart uploads were arriving corrupted at the backend —
	# admin video uploads failed with "Failed to parse body as FormData" over h3 while
	# the identical request succeeded over h2. Disabling h3 until that's tracked down.
	servers {
		protocols h1 h2
	}
}

# Automatic Let's Encrypt TLS for the apex and www.
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	@www host www.{$SITE_DOMAIN}
	redir @www https://{$SITE_DOMAIN}{uri} permanent

	encode zstd gzip
	reverse_proxy web:3000 {
		header_up X-Real-IP {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# Webmail. The mail stack (mail/compose.yaml) joins this Caddy's network as `roundcube`.
# Obtaining this cert also provisions the TLS material docker-mailserver reuses for SMTP/IMAP.
mail.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy roundcube:80 {
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
