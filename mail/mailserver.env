# docker-mailserver configuration — https://docker-mailserver.github.io/docker-mailserver/latest/config/environment/
# Tuned lean for a memory-constrained host: ClamAV + Rspamd + SpamAssassin OFF.
# Spam protection here is SPF + DKIM + DMARC verification, DNS blocklists and postscreen.
# Turn on Rspamd (ENABLE_RSPAMD=1) once the host has >1 GB free RAM for real content filtering.

OVERRIDE_HOSTNAME=mail.torotech.ca
POSTMASTER_ADDRESS=postmaster@torotech.ca
DMS_VMAIL_UID=5000
DMS_VMAIL_GID=5000
LOG_LEVEL=info
SUPERVISOR_LOGLEVEL=warn

# ---- TLS: reuse Caddy's Let's Encrypt cert for mail.torotech.ca ----
SSL_TYPE=manual
SSL_CERT_PATH=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.torotech.ca/mail.torotech.ca.crt
SSL_KEY_PATH=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/mail.torotech.ca/mail.torotech.ca.key

# ---- Anti-spam / anti-virus (lean) ----
ENABLE_CLAMAV=0
ENABLE_RSPAMD=0
ENABLE_SPAMASSASSIN=0
ENABLE_POSTGREY=0
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1
ENABLE_POSTSCREEN=1
POSTSCREEN_ACTION=enforce
ENABLE_DNSBL=1

# ---- Security ----
ENABLE_FAIL2BAN=1
SPOOF_PROTECTION=1
PERMIT_DOCKER=connected-networks
ENABLE_MANAGESIEVE=1
POSTFIX_MESSAGE_SIZE_LIMIT=26214400

# ---- Submission behaviour ----
# Clients must authenticate on 587/465; plain 25 is inbound MX only.
POSTFIX_INET_PROTOCOLS=ipv4
